# list recipes
default:
    @just -f justfile-processing --list --unsorted

# ==== data preprocessing ====

# data preprocessing: mr-pubmed-data.json
[group('data-prep')]
data-prep-mr-pubmed:
    python scripts/python/preprocessing/mr-pubmed-data-prep.py

# special sample involved in the review analysis
[group('data-prep')]
prep-special-sample:
    python scripts/python/preprocessing/prep-special-sample.py

# ==== post-batch processing ====

# Aggregate LLM batch results
[group('data-processing')]
aggregate-llm-batch-results:
    python scripts/python/postprocessing/aggregate-llm-batch-results.py --all

# Process LLM batch results
[group('data-processing')]
process-llm-batch-results:
    python scripts/python/postprocessing/process-llm-aggregated-results.py

# Aggregate OpenAI SP batch results
[group('data-processing')]
aggregate-llm-batch-results-sp:
    python scripts/python/postprocessing/aggregate-llm-batch-results-sp.py --all

# Process OpenAI SP batch results
[group('data-processing')]
process-llm-batch-results-sp:
    python scripts/python/postprocessing/process-llm-aggregated-results-sp.py

# ==== analysis ====

# Process reviewer assessment data
[group('analysis')]
process-assessment-data *args:
    python scripts/python/analysis/process-assessment-data.py {{args}}

# Assessment heatmap/performance table only; never load validation results
[group('analysis')]
assessment-assets input figures tables:
    MPLBACKEND=Agg python scripts/python/analysis/create-manuscript-assets.py --assessment-only --assessment-file "{{input}}" --output-figures "{{figures}}" --output-tables "{{tables}}" --verbose

# Heatmap only from corrected assessment input; no tables or validation
[group('analysis')]
assessment-heatmap input output:
    MPLBACKEND=Agg python scripts/python/analysis/create-manuscript-assets.py --heatmap-only --assessment-file "{{input}}" --output-figures "{{output}}" --verbose

# Focused heatmap tests with the existing environment
[group('analysis')]
assessment-heatmap-test:
    MPLBACKEND=Agg python -m pytest -q tests/test_assessment_figures.py tests/test_assessment_score_validation.py

# Non-fixing checks for the heatmap source and focused tests
[group('analysis')]
assessment-heatmap-lint:
    ruff check scripts/python/analysis/create-manuscript-assets.py tests/test_assessment_figures.py tests/test_assessment_score_validation.py

# Non-fixing checks for supplementary presentation source and tests
[group('analysis')]
assessment-presentation-lint:
    ruff check scripts/python/analysis/create-manuscript-assets.py scripts/python/analysis/create-supplementary-figures.py tests/test_assessment_figures.py tests/test_supplementary_assessment_figures.py

# Assessment presentation and score regressions; no extraction/network calls
[group('analysis')]
assessment-presentation-test:
    MPLBACKEND=Agg python -m pytest -q tests/test_assessment_figures.py tests/test_supplementary_assessment_figures.py tests/test_assessment_score_validation.py

# Supplementary assessment figures from an explicit processed input
[group('analysis')]
assessment-supplementary input output:
    python scripts/python/analysis/create-supplementary-figures.py --input-file "{{input}}" --output-dir "{{output}}" --verbose

# analysis sample: trial
[group('data-processing')]
analysis-sample-trial:
    python scripts/python/analysis/make-analysis-sample.py --size 20 --seed 42
    python scripts/python/analysis/render-analysis-sample.py --file sample-42-20.json

# analysis sample: formal
[group('data-processing')]
analysis-sample-formal:
    python scripts/python/analysis/make-analysis-sample.py --size 100 --seed 42
    python scripts/python/analysis/render-analysis-sample.py --file sample-42-100.json

# OpenAI SP analysis: all results
[group('data-processing')]
analysis-sample-sp:
    python scripts/python/analysis/make-analysis-sample-sp.py
    python scripts/python/analysis/render-analysis-sample-sp.py --file all-results.json

# vim: filetype=just

# Standalone uncertainty prototype; never process scores or canonical figures
[group('analysis')]
assessment-dimension-summary *args:
    MPLBACKEND=Agg python scripts/python/analysis/create-assessment-dimension-summary.py {{args}}

# Focused standalone bootstrap and export tests
[group('analysis')]
assessment-dimension-summary-test:
    MPLBACKEND=Agg python -m pytest -q tests/test_assessment_dimension_summary.py

# Non-fixing standalone source/test checks
[group('analysis')]
assessment-dimension-summary-lint:
    ruff check scripts/python/analysis/create-assessment-dimension-summary.py tests/test_assessment_dimension_summary.py

# Compact and combine approved statistics; no bootstrap or CSV rewrite
[group('analysis')]
assessment-combined *args:
    MPLBACKEND=Agg python scripts/python/analysis/create-assessment-dimension-summary.py --render-only {{args}}
